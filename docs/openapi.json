    "/api/cases/{case_id}/timepoints/{tp_id}/maps/{kind}": {
      "get": {
        "tags": [
          "cases"
        ],
        "summary": "Get Map",
        "description": "Overlay volumes on the image grid: label maps as uint8, continuous maps quantised to uint8.\n\n``prediction``/``uncertainty``/``saliency`` need ``model_id``; ``dose`` needs ``key`` (from a dose result).",
        "operationId": "get_map_api_cases__case_id__timepoints__tp_id__maps__kind__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          },
          {
            "name": "tp_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tp Id"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "enum": [
                "reference",
                "structures",
                "annotation",
                "prediction",
                "uncertainty",
                "saliency",
                "dose"
              ],
              "type": "string",
              "title": "Kind"
            }
          },
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,40}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Model Id"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^dose_[a-z0-9_-]{1,60}$"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
