  "components": {
    "schemas": {
      "ComparisonRequest": {
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Model Id"
          },
          "reference": {
            "type": "string",
            "enum": [
              "reference",
              "annotation"
            ],
            "title": "Reference",
            "default": "reference"
          }
        },
        "type": "object",
        "required": [
          "model_id"
        ],
        "title": "ComparisonRequest"
      },
      "DoseRequest": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^S[0-9]{1,2}$",
            "title": "Scenario Id"
          },
          "target_source": {
            "type": "string",
            "title": "Target Source",
            "default": "reference"
          }
        },
        "type": "object",
        "required": [
          "scenario_id"
        ],
        "title": "DoseRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SegmentationRequest": {
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,40}$",
            "title": "Model Id",
            "default": "demo-classical"
          },
          "mc_samples": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 0.0,
            "title": "Mc Samples",
            "description": "MC-dropout passes (deep model only)",
            "default": 8
          }
        },
        "type": "object",
        "title": "SegmentationRequest"
      },
      "SourceRequest": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'reference', 'annotation' or 'pred:<model_id>'",
            "default": "reference"
          }
        },
        "type": "object",
        "title": "SourceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}