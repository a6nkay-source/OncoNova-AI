# Copy to .env and edit. Never commit .env.
# dev: localhost only, caller is a local admin. api_key: X-API-Key header required.
ONCONOVA_AUTH_MODE=dev
# YAML file with SHA-256 hashes of API keys (see docs/DEPLOYMENT.md). Never store raw keys.
# ONCONOVA_API_KEYS_FILE=configs/api_keys.yaml
# Salt for pseudonymising DICOM identifiers. Generated into data/.pseudonym_salt if unset.
# ONCONOVA_PSEUDONYM_SALT=
ONCONOVA_MAX_UPLOAD_MB=512
ONCONOVA_LOG_LEVEL=INFO
